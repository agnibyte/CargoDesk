{
  "name": "cargodesk",
  "version": "0.1.0",
  "description": "CargoDesk Desktop Application",
  "author": "CargoDesk",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently -k \"next dev -p 3000\" \"wait-on -t 60000 http://127.0.0.1:3000 && electron .\"",
    "electron:build": "next build && electron-builder --dir",
    "electron:dist": "next build && electron-builder --win"
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "@electron/get": "3.1.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/material": "^5.16.13",
    "@mui/x-date-pickers": "^7.11.1",
    "@zxing/library": "^0.21.3",
    "cookies": "^0.9.1",
    "gapi-script": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "next": "15.3.4",
    "next-seo": "^6.8.0",
    "nookies": "^2.5.2",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.52.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.4.0",
    "react-select": "^5.8.0",
    "sass": "^1.77.8",
    "serverless-mysql": "^1.5.5",
    "twilio": "^5.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "wait-on": "^9.1.0"
  }
}
